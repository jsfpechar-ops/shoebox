# Shoebox: secret NAMES only (M12 §4.13). Never put a value here.
# Local dev uses Supabase CLI defaults and replay cassettes; no production secret is needed locally.

# Database (Secret Manager -> Cloud Run env)
DATABASE_URL=
DATABASE_URL_MIGRATE=
DATABASE_URL_WORKER=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public origin of the web app (magic-link return address and redirects), e.g. https://app.example.cz
APP_URL=
# OAuth provider secrets for the Supabase CLI config (auth.external.*); empty until the owner enables a provider
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# Inbound e-mail webhook (list, newest first)
INBOUND_WEBHOOK_SECRETS=

# Sentry (SENTRY_AUTH_TOKEN lives in GitHub Actions secrets)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# CSP violation reports (Sentry security endpoint); empty = no report-uri in the CSP
CSP_REPORT_URI=

# Cloudflare (GitHub Actions secret, deploy only)
CLOUDFLARE_API_TOKEN=

# SES SMTP (sending only)
SES_SMTP_USER=
SES_SMTP_PASSWORD=

# Vertex AI: no key (Cloud Run service account). GCP deploy: Workload Identity Federation, no key.
