{
  "name": "@shoebox/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design system components and tokens (07).",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./fonts": {
      "types": "./src/fonts.ts",
      "default": "./src/fonts.ts"
    },
    "./tokens.css": "./src/tokens.css",
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --environment happy-dom",
    "test:a11y": "vitest run --environment happy-dom a11y"
  },
  "dependencies": {
    "@shoebox/domain": "workspace:*",
    "@shoebox/i18n": "workspace:*",
    "lucide-react": "1.51.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "happy-dom": "catalog:",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
